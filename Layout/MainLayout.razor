@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Color="Color.Error" Class="mr-4"><b>Afya Pedagógico</b></MudText>
        
        <MudText Typo="Typo.body2" Class="mud-text-secondary ml-4 d-none d-md-block">Home / Dashboard</MudText>
        
        <MudSpacer />
        
        <MudTextField T="string" Placeholder="Pesquisar..." Variant="Variant.Outlined" Margin="Margin.Dense" 
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" 
                      Class="d-none d-md-flex mt-2" Style="max-width: 400px;" />
        
        <MudSpacer />
        
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Default" OnClick="@DarkModeToggle" />
        <MudBadge Content="3" Color="Color.Error" Overlap="true" Class="mx-2">
            <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Default" />
        </MudBadge>
        
        <div class="d-flex align-center ml-3">
            <MudAvatar Color="Color.Primary" Size="Size.Small">AM</MudAvatar>
            <div class="d-none d-md-flex flex-column ml-2">
                <MudText Typo="Typo.body2"><b>Alex Morgan</b> <span style="color: #108981; font-size: 0.8em;">Online</span></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">alex.morgan@afya.com.br</MudText>
            </div>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Color="Color.Error"><b>Afya Pedagógico</b></MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false; // Começa no tema claro por padrão

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }
}
