<MudStack AlignItems="AlignItems.Center" Class="mb-4" Justify="Justify.SpaceBetween" Row="true" Wrap="Wrap.Wrap">
    <div>
        <MudText Tag="h1" Typo="Typo.h5">@Titulo</MudText>
        @if (!string.IsNullOrEmpty(Subtitulo))
        {
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@Subtitulo</MudText>
        }
    </div>
    <div>
        @ChildContent
    </div>
</MudStack>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
